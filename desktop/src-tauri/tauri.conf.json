{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiHome Mac",
  "version": "0.1.0",
  "identifier": "com.reign9201.mihomemac",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "MiHome Mac",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../helpers/go2rtc/go2rtc": "go2rtc",
      "../../helpers/go2rtc/LICENSE": "go2rtc-LICENSE"
    }
  }
}
