{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiHome Mac",
  "version": "0.1.0",
  "identifier": "com.reign9201.mihomemac",
  "build": {
    "beforeBundleCommand": "bash ../scripts/strip-macos-binary.sh",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "MiHome Mac",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": [
      "../../helpers/go2rtc/go2rtc"
    ],
    "resources": {
      "../../helpers/go2rtc/LICENSE": "go2rtc-LICENSE",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
