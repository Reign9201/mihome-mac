{
  "name": "mihome-mac-desktop",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "MiHome Mac desktop shell",
  "scripts": {
    "tauri": "tauri",
    "bridge": "esbuild ui/tauri-bridge.mjs --bundle --format=iife --platform=browser --target=safari15 --outfile=ui/tauri-api.js",
    "dev": "npm run bridge && tauri dev",
    "build": "npm run bridge && tauri build",
    "check": "npm run bridge && node --check ui/tauri-api.js && node --check ui/app.js && node --check ui/icons.js && node --check ui/capabilities.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
